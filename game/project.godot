; ShadowShift - Godot 4.7 Compatibility
config_version=5

[application]
config/name="ShadowShift"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Ride the dark. Strike once. Leave no witness."

[autoload]
RunStats="*res://core/run_stats.gd"

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.065, 1)

[physics]
common/physics_ticks_per_second=60

